      "id": "7cf41956-010b-4637-9130-3e5920695493",
      "name": "Auth",
      "description": {
        "content": "Authenticate to the Cluster API by creating and terminating API sessions. Session tokens are passed via the X-Cockroach-API-Session header on subsequent requests.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c700de5d-9107-4acb-b61a-379f6af11b50",
          "name": "Create a session",
          "request": {
            "name": "Create a session",
            "description": {
              "content": "Creates an authenticated API session by supplying valid SQL username and password credentials. Returns a session token in the X-Cockroach-API-Session response header. This token must be included as the X-Cockroach-API-Session header on all subsequent requests to authenticated endpoints.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "login",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"<string>\",\n  \"password\": \"<password>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "d6b3fed3-ecd1-4948-8b67-8f2a74b91981",
              "name": "Session created successfully. The session token is returned in the X-Cockroach-API-Session response header.",
              "originalRequest": {
