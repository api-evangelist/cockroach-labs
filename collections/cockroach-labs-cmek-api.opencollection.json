{
  "opencollection": "1.0.0",
  "info": {
    "name": "CockroachDB Cloud APIKeys CMEK API",
    "version": "2024-09-16"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "CMEK",
        "type": "folder"
      },
      "items": [
        {
          "info": {
