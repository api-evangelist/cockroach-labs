  "item": [
    {
      "id": "57bb8ab1-f5a3-4d09-ba53-561ef20398fb",
      "name": "Health",
      "description": {
        "content": "Check the health and readiness of individual CockroachDB nodes. The health endpoint can report whether the node is live and fully operational for accepting SQL connections.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "07f41b9c-7d83-4cb3-b8bd-70111b274d98",
          "name": "Check node health",
          "request": {
            "name": "Check node health",
            "description": {
              "content": "Reports the health of the CockroachDB node. When the optional ready parameter is set to true, the endpoint also verifies that the node is fully operational and ready to accept SQL connections. Returns HTTP 200 if healthy, or HTTP 500 if not ready. This endpoint does not require authentication.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "health",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ready",
                  "value": "<boolean>",
                  "description": "If true, checks whether the node is fully ready to accept SQL connections in addition to being live."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "04656e10-3fa5-49a4-a958-6a5aef389eed",
              "name": "Node is healthy and, if ready was requested, fully operational.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v2",
                    "health",
                    ""
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "ready",
                      "value": "<boolean>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"node_id\": 6500,\n  \"ready\": true\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
            {
